{
  "name": "cordova-plugin-resource-generator",
  "version": "0.2.0",
  "description": "Generates missing Cordova icons and splash screens from resources/icon.png without overwriting existing files",
  "scripts": {
    "postinstall": "node scripts/generate-resources.js"
  },
  "cordova": {
    "id": "cordova-plugin-resource-generator",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apperyio/cordova-plugin-resource-generator"
  },
  "keywords": [
    "cordova",
    "device",
    "appery",
    "cordova-ios",
    "cordova-android",
    "cordova-res"
  ],
  "engines": [
    {
      "name": "cordova",
      "version": ">=3.0.0"
    }
  ],
  "dependencies": {
    "sharp": "0.33.5"
  },
  "author": "Andrii Iakovenko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/apperyio/cordova-plugin-resource-generator/issues"
  },
  "homepage": "https://appery.io"
}
